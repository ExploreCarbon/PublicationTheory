{
  "name": "explorecarbon/sentinel-publication-workflow",
  "description": "Publication workflow for Sentinel Group",
  "type": "wordpress-plugin",
  "license": "proprietary",
  "require": { "php": ">=8.1" },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "yoast/phpunit-polyfills": "^2.0",
    "wp-phpunit/wp-phpunit": "7.1.2"
  },
  "config": { "allow-plugins": { "composer/installers": true } },
  "scripts": { "test": "phpunit -c phpunit.xml.dist" }
}
